{
  // FanOMax : ÉTAPE 1 : IDENTIFICATION du canal Fan #1 (/lpc/nct6796dr/0/control/0).
  // FanOMax pilote UNIQUEMENT ce canal, à 100 % fixe. Tous les autres ventilateurs restent au BIOS.
  // Regarder / écouter quel(s) ventilateur(s) accélère(nt) dans les 10 s.
  // La température critique (90 °C) reste prioritaire. Retour arrière : etape-0-fantome.json.
  "FanOMax": {
    "Mode": "Active",
    "Profile": "Normal",
    "IntervalSeconds": 1,
    "Groups": [
      {
        "Name": "Identification Fan #1",
        "Kind": "Cpu",
        "Enabled": true,
        "TemperatureSensor": "/amdcpu/0/temperature/2",
        "PowerSensor": "/amdcpu/0/power/0",
        "Controls": [ "/lpc/nct6796dr/0/control/0" ],
        "FixedPercent": 100,
        "TargetTemperature": 69,
        "CriticalTemperature": 90
      },
      {
        "Name": "GPU",
        "Kind": "Gpu",
        // Désactivé pendant l'identification : le pilote AMD garde la main sur le GPU.
        "Enabled": false,
        "TemperatureSensor": "/gpu-amd/0/temperature/7",
        "PowerSensor": "/gpu-amd/0/power/3",
        "Controls": [ "/gpu-amd/0/control/0" ]
      }
    ],
    "Safety": { "WatchdogSeconds": 5, "MaxConsecutiveErrors": 5, "ResumeAfterSeconds": 30 },
    "ShadowLog": { "Enabled": true, "RetentionDays": 7 }
  }
}