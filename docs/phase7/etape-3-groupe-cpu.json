{
  // FanOMax : ÉTAPE 3 : FanOMax PILOTE le groupe CPU (ventirad + tous les ventilateurs de boîtier), cible 69 °C.
  // Identification du 2026-10-09 (complétée à 11:49) : Fan #1 ventirad, Fan #2 haut, Fan #4 hub avant (3 ventilateurs),
  // Fan #7 arrière ; Fan #3 et #5 vides.
  // Le GPU reste piloté par le pilote AMD. Retour arrière : etape-0-fantome.json.
  "FanOMax": {
    "Mode": "Active",
    "Profile": "Normal",
    "IntervalSeconds": 1,
    "Groups": [
      {
        "Name": "CPU",
        "Kind": "Cpu",
        "Enabled": true,
        "TemperatureSensor": "/amdcpu/0/temperature/2",
        "PowerSensor": "/amdcpu/0/power/0",
        // Fan #1 ventirad · Fan #2 haut (extraction) · Fan #4 avant, hub de 3 (admission, sans régime remonté) · Fan #7 arrière (extraction).
        "Controls": [ "/lpc/nct6796dr/0/control/0", "/lpc/nct6796dr/0/control/1", "/lpc/nct6796dr/0/control/3", "/lpc/nct6796dr/0/control/6" ],
        // Pression POSITIVE (choix du 2026-10-09) : même % partout, 3 ventilateurs en admission contre 2 en extraction.
        // L'air entre par les filtres de l'avant ; la poussière n'entre pas par les fentes.
        // Pour régler l'avant à part, ajouter par exemple : "ControlScales": { "/lpc/nct6796dr/0/control/3": 0.8 },
        "TargetTemperature": 69,
        "CriticalTemperature": 90
      },
      {
        "Name": "GPU",
        "Kind": "Gpu",
        // Étape suivante : le pilote AMD garde la main sur le GPU pour l'instant.
        "Enabled": false,
        "TemperatureSensor": "/gpu-amd/0/temperature/7",
        "PowerSensor": "/gpu-amd/0/power/3",
        "Controls": [ "/gpu-amd/0/control/0" ]
      }
    ],
    "Safety": { "WatchdogSeconds": 5, "MaxConsecutiveErrors": 5, "ResumeAfterSeconds": 30 },
    "ShadowLog": { "Enabled": true, "RetentionDays": 7 }
  }
}
